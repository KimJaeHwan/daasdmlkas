# shell scripts run in WSL / Linux: always LF, whatever core.autocrlf says
*.sh text eol=lf
# Derived model provenance hashes raw model bytes: use the same bytes on every OS.
models/**/*.json text eol=lf
# Corpus C sources are pinned by SHA-256 of their bytes (binary fixtures): LF on every OS.
tests/corpus/sources/*.c text eol=lf
