{
 "schema": "tbr-iclass-map-2",
 "design": ".census6/design_tbr_isa_facts_r3.md s1 (per-voter lookup); .census6/design_tbr_isa_ordinary_r3.md s3 / r2 A (cited first, NOP qualified, split fallbacks)",
 "matching": "per voter: the first rule whose voters include the voter, whose mnemonic list holds the voter's mnemonic (upper-cased; \"*\" = any) and whose `when` holds gives the key; no rule -> the voter's cited lookup is absent. key \"=\" is the upper-cased mnemonic itself.",
 "when_fields": {
  "operand_bits": "the voter's effective operand size",
  "flow": "the voter's G1 flow kind",
  "counter": "the voter's loop / jcxz flag (true / false)",
  "target_kind": "the voter's explicit near CALL / JMP target kind (list: any of)",
  "opcode": "the opcode bytes after legacy and REX prefixes, hex, compared as a prefix of the opcode (list: any of)",
  "modrm_reg": "ModRM.reg of the byte after `opcode` (list: any of)",
  "prefix": "a legacy prefix that must be present (hex)",
  "modrm": "the exact ModRM byte after `opcode` (list: any of, hex)"
 },
 "rules": [
  {"voters": ["zydis", "xed"], "mnemonic": ["SYSRET"], "when": {"operand_bits": 64}, "key": "SYSRETQ"},
  {"voters": ["xed"], "mnemonic": ["SYSRET64"], "key": "SYSRETQ"},
  {"voters": ["zydis", "xed"], "mnemonic": ["SYSEXIT"], "when": {"operand_bits": 64}, "key": "SYSEXITQ"},
  {"mnemonic": ["SYSRET", "SYSRETQ", "SYSEXIT", "SYSEXITQ"], "key": "="},

  {"voters": ["iced"], "mnemonic": ["RETF"], "key": "RET_FAR"},
  {"voters": ["xed"], "mnemonic": ["RET_FAR"], "key": "="},
  {"voters": ["iced", "zydis"], "mnemonic": ["RET"], "when": {"flow": "ret_far"}, "key": "RET_FAR"},
  {"voters": ["xed"], "mnemonic": ["RET_NEAR"], "when": {"opcode": ["C2"]}, "key": "RET_NEAR_IMM"},
  {"voters": ["xed"], "mnemonic": ["RET_NEAR"], "when": {"opcode": ["C3"]}, "key": "RET_NEAR"},
  {"voters": ["iced", "zydis"], "mnemonic": ["RET"], "when": {"flow": "ret_near", "opcode": ["C2"]}, "key": "RET_NEAR_IMM"},
  {"voters": ["iced", "zydis"], "mnemonic": ["RET"], "when": {"flow": "ret_near", "opcode": ["C3"]}, "key": "RET_NEAR"},

  {"voters": ["xed"], "mnemonic": ["JMP_FAR", "CALL_FAR"], "key": "="},
  {"voters": ["iced", "zydis"], "mnemonic": ["JMP"], "when": {"flow": "jmp_far"}, "key": "JMP_FAR"},
  {"voters": ["iced", "zydis"], "mnemonic": ["CALL"], "when": {"flow": "call_far"}, "key": "CALL_FAR"},
  {"voters": ["iced", "zydis"], "mnemonic": ["CALL"], "when": {"flow": "call_near", "target_kind": ["register", "memory"]},
   "key": "CALL_NEAR_INDIRECT"},
  {"voters": ["xed"], "mnemonic": ["CALL_NEAR"], "when": {"target_kind": ["register", "memory"]}, "key": "CALL_NEAR_INDIRECT"},
  {"voters": ["iced", "zydis"], "mnemonic": ["CALL"], "when": {"flow": "call_near", "target_kind": ["direct"], "opcode": ["E8"]},
   "key": "CALL_NEAR"},
  {"voters": ["xed"], "mnemonic": ["CALL_NEAR"], "when": {"target_kind": ["direct"], "opcode": ["E8"]}, "key": "CALL_NEAR"},
  {"mnemonic": ["JMP"], "when": {"flow": "jmp_near", "target_kind": ["register", "memory"]}, "key": "JMP_NEAR_INDIRECT"},
  {"mnemonic": ["JMP"], "when": {"flow": "jmp_near", "target_kind": ["direct"], "opcode": ["E9"]}, "key": "JMP_NEAR"},
  {"mnemonic": ["JMP"], "when": {"flow": "jmp_near", "target_kind": ["direct"], "opcode": ["EB"]}, "key": "JMP_SHORT"},
  {"mnemonic": ["*"], "when": {"flow": "jcc", "counter": true, "opcode": ["E0", "E1", "E2", "E3"]}, "key": "LOOP_JCXZ"},
  {"mnemonic": ["*"], "when": {"flow": "jcc", "counter": false,
                                "opcode": ["70", "71", "72", "73", "74", "75", "76", "77", "78", "79", "7A", "7B", "7C", "7D", "7E", "7F"]},
   "key": "JCC_SHORT"},
  {"mnemonic": ["*"], "when": {"flow": "jcc", "counter": false,
                                "opcode": ["0F80", "0F81", "0F82", "0F83", "0F84", "0F85", "0F86", "0F87", "0F88", "0F89",
                                           "0F8A", "0F8B", "0F8C", "0F8D", "0F8E", "0F8F"]},
   "key": "JCC_NEAR"},

  {"voters": ["xed"], "mnemonic": ["MOV_CR", "MOV_DR"], "key": "="},
  {"voters": ["iced", "zydis"], "mnemonic": ["MOV"], "when": {"opcode": ["0F20", "0F22"]}, "key": "MOV_CR"},
  {"voters": ["iced", "zydis"], "mnemonic": ["MOV"], "when": {"opcode": ["0F21", "0F23"]}, "key": "MOV_DR"},
  {"mnemonic": ["MOV"], "when": {"opcode": ["8E"], "modrm_reg": [4]}, "key": "MOV_TO_FS"},
  {"mnemonic": ["MOV"], "when": {"opcode": ["8E"], "modrm_reg": [5]}, "key": "MOV_TO_GS"},
  {"mnemonic": ["MOV"], "when": {"opcode": ["8E"], "modrm_reg": [2]}, "key": "MOV_TO_SS"},
  {"mnemonic": ["MOV"], "when": {"opcode": ["8E"], "modrm_reg": [0, 3]}, "key": "MOV_TO_DS_ES"},
  {"mnemonic": ["MOV"], "when": {"opcode": ["8C"]}, "key": "MOV_FROM_SREG"},
  {"mnemonic": ["POP"], "when": {"opcode": ["0FA1"]}, "key": "POP_FS"},
  {"mnemonic": ["POP"], "when": {"opcode": ["0FA9"]}, "key": "POP_GS"},
  {"mnemonic": ["PUSH"], "when": {"opcode": ["0FA0"]}, "key": "PUSH_FS"},
  {"mnemonic": ["PUSH"], "when": {"opcode": ["0FA8"]}, "key": "PUSH_GS"},
  {"mnemonic": ["BSWAP"], "when": {"operand_bits": 16}, "key": "BSWAP16"},
  {"mnemonic": ["SHLD"], "when": {"operand_bits": 16}, "key": "SHLD16"},
  {"mnemonic": ["SHRD"], "when": {"operand_bits": 16}, "key": "SHRD16"},
  {"voters": ["xed"], "mnemonic": ["REP_INSB"], "key": "INSB"},
  {"voters": ["xed"], "mnemonic": ["REP_INSW"], "key": "INSW"},
  {"voters": ["xed"], "mnemonic": ["REP_INSD"], "key": "INSD"},
  {"voters": ["xed"], "mnemonic": ["REP_OUTSB"], "key": "OUTSB"},
  {"voters": ["xed"], "mnemonic": ["REP_OUTSW"], "key": "OUTSW"},
  {"voters": ["xed"], "mnemonic": ["REP_OUTSD"], "key": "OUTSD"},

  {"mnemonic": ["NOP"], "when": {"opcode": ["90"]}, "key": "NOP"},
  {"mnemonic": ["NOP"], "when": {"opcode": ["0F1F"], "modrm_reg": [0]}, "key": "NOP"},
  {"mnemonic": ["NOP"], "when": {"opcode": ["0F1E"], "modrm": ["FA", "FB"], "prefix": "F3"}, "key": "NOP"},

  {"mnemonic": ["LGDT", "LIDT", "LLDT", "LTR", "CLTS", "LMSW", "INVD", "WBINVD", "INVLPG", "SWAPGS", "RDMSR", "WRMSR",
                "HLT", "SYSCALL", "SYSENTER", "INT3", "INT", "INT1", "UD0", "UD1", "UD2", "IRET", "IRETD", "IRETQ",
                "IN", "OUT", "INSB", "INSW", "INSD", "OUTSB", "OUTSW", "OUTSD", "CLI", "STI", "POPF", "POPFQ",
                "PUSHF", "PUSHFQ", "LSS",
                "CPUID", "RDTSC", "RDTSCP", "RDPMC", "RDPKRU", "WRPKRU", "XGETBV", "SGDT", "SIDT", "SLDT", "SMSW",
                "STR", "LAR", "LSL", "RDFSBASE", "RDGSBASE", "WRFSBASE", "WRGSBASE", "RDRAND", "RDSEED", "RDPID",
                "XBEGIN", "XEND", "XABORT", "LFS", "LGS", "BSF", "BSR", "TZCNT", "LZCNT", "PAUSE",
                "ENDBR64", "ENDBR32"], "key": "="}
 ]
}
