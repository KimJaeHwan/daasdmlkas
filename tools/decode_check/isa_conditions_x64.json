  "TABLE_E4": {"rule": "BND0-BND3 are initialised only when MPX is enabled, BNDCFGx.BNDPRESERVE = 0 and no effective BND (F2) prefix is present; with an effective BND prefix, or with MPX disabled or absent, BND0-BND3 are unchanged",
               "members": ["E8", "FF /2", "C2", "C3", "E9", "FF /4", "70-7F", "0F 80-8F"],
               "not_members": ["EB", "E0-E3", "far branches"],
               "cite": [{"doc": "SDM1", "entry": "E.5.3, Table E-4 (branch instructions and the BND prefix)"}]}
