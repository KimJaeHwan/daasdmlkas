 "conditions": {
  "CPL=0": "current privilege level 0 at the row",
  "CPL=3": "current privilege level 3 at the row",
  "CPL<=IOPL": "CPL not greater than RFLAGS.IOPL",
  "IOPL<3": "RFLAGS.IOPL below 3",
  "TSS_IO_BITMAP_PERMITS": "the TSS I/O permission bitmap allows every port byte of the access width",
  "CR4.PVI=1": "protected-mode virtual interrupts enabled",
  "RFLAGS.VIP=0": "no virtual interrupt pending (state-dependent)",
  "CR4.TSD=0": "time-stamp disable clear",
  "CPUID_FAULTING=0": "CPUID faulting not enabled (MSR_MISC_FEATURES_ENABLES bit 0)",
  "CR4.UMIP=0": "user-mode instruction prevention clear",
  "CR4.FSGSBASE=1": "FS / GS base instructions enabled",
  "CR4.PCE=1": "performance-counter enable set",
  "CR4.PKE=1": "protection keys for user pages enabled",
  "CR4.OSXSAVE=1": "XSAVE enabled by the OS",
  "XCR0.SSE=1": "XCR0 bit 1 (XMM state) set",
  "XCR0.AVX=1": "XCR0 bit 2 (YMM state) set",
  "EFER.SCE=1": "IA32_EFER.SCE set (SYSCALL / SYSRET enabled)",
  "SYSENTER_CS!=0": "IA32_SYSENTER_CS selector not null"
 },
 "f3_tags": ["os_transfer", "privileged_return", "halt", "transactional", "may_change_mode", "ud"],
 "cet_expressions": {
  "rel32 != 0": "the direct CALL's displacement is not zero (a CALL with displacement 0 pushes nothing on the shadow stack)",
  "NOTRACK": "a 3E prefix is present, no 64 / 65 prefix is present, and NO_TRACK_EN = 1 in the CET MSR of the current CPL (IA32_U_CET at CPL3, IA32_S_CET at CPL0)"
 },
